#:kivy 2.3.1

#:import Logger kivy.logger.Logger
#:import Factory kivy.factory.Factory
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

#:import Padding config.Padding
#:import Size config.Size
#:import Spacing config.Spacing
#:import application_path utils.application_path
#:import formated_time main.formated_time

<TopPanel@BoxLayout>:
    size_hint: Size.top_buttons
    orientation: "horizontal"
    BackButton:
        size_hint: None, 1
        size: 25, 25
        source: f"{application_path}/resources/images/arrow_back.png"
        on_release: self.go_back()
        background_normal: ""
        background_color: app.theme.transparent
        color: app.theme.icon
    Widget:
    OptionsButton:
        size_hint: None, 1
        size: 25, 25
        source: f"{application_path}/resources/images/more_vert.png"
        on_release: Factory.Options().open()
        background_normal: ""
        background_color: app.theme.transparent
        color: app.theme.icon

<PathView>:
    pos:
    Label:
        id: path_label
        font_name: app.font
        color: app.theme.text
    Button:
        id: remove_path
        size_hint: .2, 1
        text: "Remove"
        font_name: app.font
        color: app.theme.button_text
        on_release: root.remove_path()
        background_normal: ""
        background_color: app.theme.transparent

<PathsView>:
    paths_amount:
    viewclass: "PathView"
    bar_width: dp(0)
    scroll_wheel_distance: dp(30)
    effect_cls: ScrollEffect
    RecycleBoxLayout:
        default_size: None, dp(30)
        default_size_hint: 1, None
        height: self.minimum_height
        orientation: "vertical"
        size_hint_y: None
        spacing: 10

<SettingsTopPanel@BoxLayout>:
    size_hint: Size.top_buttons
    spacing: 5
    BackButton:
        size_hint: None, 1
        size: 25, 25
        source: f"{application_path}/resources/images/arrow_back.png"
        on_release: self.go_back()
        background_normal: ""
        background_color: app.theme.transparent
        color: app.theme.icon
    Widget:
    SettingsButton:
        size_hint: None, 1
        size: 25, 25
        source: f"{application_path}/resources/images/settings.png"
        on_release: self.open_settings()
        background_normal: ""
        background_color: app.theme.transparent
        color: app.theme.icon

# TODO make canvas https://kivy.org/doc/stable/api-kivy.uix.dropdown.html#kivy.uix.dropdown.DropDown
<ThemeSpinnerOption>:
    color: app.theme.button_text
    background_color: app.theme.background_secondary
    font_name: app.font

<SettingsScreen>:
    on_pre_enter: self.update_settings_screen()
    Widget:
        canvas.before:
            Color:
                rgba: app.theme.background
            Rectangle:
                size: root.size
    BoxLayout:
        padding: Padding.box
        orientation: 'vertical'
        size: root.size
        spacing: Spacing.box

        SettingsTopPanel:

        Label: 
            text: f"smpl - {app.version}"
            size_hint_y: None
            height: 20
            font_name: app.font
            color: app.theme.text
        Label:
            canvas.before:
                Color:
                    rgba: app.theme.border
                Line:
                    points: self.x, self.y + self.size[1], self.x + self.size[0], self.y + self.size[1]
            text: "Theme"
            size_hint_y: None
            height: 30
            font_name: app.font
            color: app.theme.text
        ThemeSpinner:
            size_hint_y: None
            height: 30
            text: app.theme.name
            font_name: app.font
            values: app.available_themes
            on_text: app.change_theme(self.text)
            background_color: app.theme.transparent
            color: app.theme.button_text

        Label:
            canvas.before:
                Color:
                    rgba: app.theme.border
                Line:
                    points: self.x, self.y + self.size[1], self.x + self.size[0], self.y + self.size[1]
            text: "Music paths"
            size_hint_y: None
            height: 30
            font_name: app.font
            color: app.theme.text
        BoxLayout:
            size_hint: 1, None
            height: self.minimum_height
            cols: 2
            spacing: 10
            PathTextInput:
                id: path_text_input
                height: 40
                background_normal: ""
                background_active: ""
                background_color: app.theme.background
                foreground_color: app.theme.text
                size_hint_y: None
                multiline: False
                font_size: 15
                font_name: app.font
                text: self.quote
                on_text_validate: root.save_music_path_from_text_input()
                cursor_blink: False
                cursor_color: app.theme.secondary
                foreground_color: app.theme.text
            Button:
                height: 30
                size_hint_y: None
                size_hint_x: .2
                text: "Save"
                on_release: root.save_music_path_from_text_input()
                color: app.theme.button_text
                font_name: app.font
                pos_hint: {"center_y": .5}
                background_normal: ""
                background_color: app.theme.transparent
        Button:
            height: 30
            size_hint_y: None
            # size_hint_x: .2
            text: "Choose path via file picker"
            color: app.theme.button_text
            on_release: app.run_save_path()
            background_color: app.theme.transparent
            background_normal: ""
            font_name: app.font
        PathsView:
            id: psv
        ScanIconButton:
            source: f"{application_path}/resources/images/sync.png"
            height: 30
            size_hint_y: None
            size_hint_x: 0.2
            fit_mode: "contain"
            on_release: self.scan()
            background_color: app.theme.transparent
            background_normal: ""
            color: app.theme.icon

<LibraryTopPanel@BoxLayout>:
    size_hint: Size.top_buttons
    spacing: 5
    BackButton:
        size_hint: None, 1
        size: 25, 25
        source: f"{application_path}/resources/images/arrow_back.png"
        on_release: self.go_back()
        background_color: app.theme.transparent
        background_normal: ""
        color: app.theme.icon
    SearchTextInput:
        id: search_text_input
        background_normal: ""
        background_active: ""
        background_color: app.theme.transparent
        foreground_color: 1, 1, 1, 1
        disabled: self.disabled
        size_hint: 1, 1
        # pos_hint: {"center_y": .5}
        # size: 25, 25
        font_name: app.font
        font_size: 15
        multiline: False
        focus: False
        cursor_blink: False
        cursor_color: app.theme.secondary
        foreground_color: app.theme.text
    ClearButton:
        id: clear_button
        source: f"{application_path}/resources/images/clear.png"
        on_release: app.clear_search()
        size_hint: None, 1
        size: 25, 25
        background_color: app.theme.transparent
        background_normal: ""
        color: app.theme.transparent
    ImageButton:
        source: f"{application_path}/resources/images/search.png"
        on_release: app.open_search()
        size_hint: None, 1
        size: 25, 25
        background_color: app.theme.transparent
        background_normal: ""
        color: app.theme.icon
    SettingsButton:
        size_hint: None, 1
        size: 25, 25
        source: f"{application_path}/resources/images/settings.png"
        on_release: self.open_settings()
        background_color: app.theme.transparent
        background_normal: ""
        color: app.theme.icon

<ArtistOptions>:
    size_hint: None, None
    size: 300, 150
    background_color: app.theme.background_secondary
    GridLayout:
        rows: 3
        OptionsPlayButton:
            on_release: root.play()
            background_normal: ""
            background_color: app.theme.transparent
        AddToQueueButton:
            on_release: root.add_to_queue()
            background_normal: ""
            background_color: app.theme.transparent
        InsertNextButton:
            on_release: root.insert_next()
            background_normal: ""
            background_color: app.theme.transparent

<AlbumOptions>:
    size_hint: None, None
    size: 300, 150
    background_color: app.theme.background_secondary
    GridLayout:
        rows: 3
        OptionsPlayButton:
            on_release: root.play()
            background_color: app.theme.transparent
        AddToQueueButton:
            on_release: root.add_to_queue()
            background_color: app.theme.transparent
        InsertNextButton:
            on_release: root.insert_next()
            background_color: app.theme.transparent

<AlbumView>:
    on_release: self.open_album()
    background_color: app.theme.transparent
    background_normal: ""
    Image:
        id: cover
        size_hint: None, 1
        fit_mode: "contain"
    BoxLayout:
        orientation: "vertical"
        Label:
            color: app.theme.text
            id: title
            font_size: Size.queue_title_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "bottom"
        Label:
            color: app.theme.text
            id: artist_year
            font_size: Size.queue_artist_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "top"
    AnchorLayout:
        size_hint: None, 1
        size: 25, 25
        Button:
            id: uv_options
            on_release: Factory.AlbumOptions(root.ids.title.text).open()
            background_color: app.theme.transparent
            background_normal: ""
        Image:
            source: f'{application_path}/resources/images/more_vert.png'
            fit_mode: "contain"
            background_color: app.theme.transparent
            background_normal: ""
            color: app.theme.icon

<ArtistView>:
    on_release: self.open_artist()
    background_color: app.theme.transparent
    background_normal: ""
    Image:
        id: cover
        size_hint: None, 1
        fit_mode: "contain"
    BoxLayout:
        orientation: "vertical"
        Label:
            color: app.theme.text
            id: name
            font_size: Size.queue_title_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "center"
    AnchorLayout:
        size_hint: None, 1
        size: 25, 25
        Button:
            id: uv_options
            on_release: Factory.ArtistOptions(root.ids.name.text).open()
            background_color: app.theme.transparent
            background_normal: ""
        Image:
            source: f'{application_path}/resources/images/more_vert.png'
            fit_mode: "contain"
            background_color: app.theme.text
            background_normal: ""
            color: app.theme.icon

<LibraryView>:
    viewclass: self.view_class
    # TODO crate bar for library view
    # bar_width: dp(6)
    bar_width: dp(0)
    scroll_wheel_distance: dp(56)
    effect_cls: ScrollEffect
    JumpRecycleBoxLayout:
        default_size: None, dp(56)
        default_size_hint: 1, None
        height: self.minimum_height
        orientation: "vertical"
        size_hint_y: None
        spacing: 10

<FilterButton>:
    chosen_filter: False
    font_name: app.font
    background_color: app.theme.transparent
    color: app.theme.secondary if self.chosen_filter else app.theme.button_text
    bold: True if self.chosen_filter else False
    background_down: ""
    background_normal: ""

<LibraryPlayer>:
    on_release: self.open_player()
    background_color: app.theme.transparent
    background_normal: ""
    height: dp(56)
    size_hint: 1, None
    row_default_height: dp(56)
    row_force_default: True
    Image:
        size_hint: 1, 1
        source: app.player.now_playing.image
        size: self.texture_size
        fit_mode: "contain"
    GridLayout:
        rows: 2
        Label:
            color: app.theme.text
            font_size: Size.queue_title_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "bottom"
            text: app.player.now_playing.title
        Label:
            color: app.theme.text
            font_size: Size.queue_artist_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "top"
            text: app.player.now_playing.artist
    Label:
        color: app.theme.text
        valign: "center"
        halign: "center"
        text_size: self.size
        size: self.texture_size
        font_name: app.font
        text: root.track_pos
        pos_hint: {"center_y": .5}
    LibraryPlayButton:
        id: lib_play_button
        size_hint: None, None
        size: 40, 40
        pos_hint: {"center_y": .5}
        source: f"{application_path}/resources/images/play_circle.png"
        fit_mode: "contain"
        on_release: self.toggle_play()
        background_color: app.theme.transparent
        background_normal: ""
        color: app.theme.icon

<LibraryScreen>:
    on_pre_enter: self.update_lv()
    Widget:
        canvas.before:
            Color:
                rgba: app.theme.background
            Rectangle:
                size: root.size
    BoxLayout:
        id: lib_box
        padding: Padding.box
        orientation: 'vertical'
        size: root.size
        spacing: Spacing.box

        LibraryTopPanel:
            id: lib_top_panel

        LibraryFilter:
            id: lib_filter
            cols: 3
            height: dp(28)
            size_hint: 1, None
            row_default_height: dp(28)
            row_force_default: True
            FilterButton:
                id: filter_artists
                text: "Artists"
                on_release: self.change_view_artists()
            FilterButton:
                id: filter_albums
                text: "Albums"
                on_release: self.change_view_albums()
            FilterButton:
                id: filter_songs
                text: "Songs"
                on_release: self.change_view_songs()

        LibraryView:
            id: lv

<Options>:
    id: options
    size_hint: None, None
    size: 300, 150
    title: ""
    separator_height: 0
    background_color: app.theme.background_secondary
    # canvas.before:
    #     Color:
    #         rgba: app.theme.background
    #     Rectangle:
    #         size: root.size
    BoxLayout:
        orientation: "vertical"
        GridLayout:
            height: self.minimum_height
            size_hint: 1, None
            rows: 2
            padding: 0, 0, 0, 40
            Label:
                color: app.theme.text
                size_hint_y: None
                text: "Volume"
                shorten: True
                shorten_from: "right"
                font_name: app.font
                text_size: self.size
                size: self.texture_size
                halign: "center"
                valign: "center"
                background_color: app.theme.transparent
            GridLayout:
                rows: 1
                cols: 2
                VolumeSlider:
                    size_hint_y: None
                    size_hint_x: .8
                    height: 10
                    orientation: "horizontal"
                    range: (0, 1)
                    value: app.volume
                    on_touch_move: self.slider_move(args[1], self)
                    on_touch_up: self.slider_up(args[1], self)
                    value_track: True if app.volume != 0 else False
                    value_track_color: app.theme.secondary
                    value_track_width: 3
                    background_width: self.value_track_width * 8
                    step: 0.05
                    cursor_size: 0, 0
                Label:
                    color: app.theme.text
                    size_hint_y: None
                    size_hint_x: .2
                    height: 10
                    text: str(int(app.volume * 100)) + "%"
                    font_name: app.font
                    text_size: self.size
                    size: self.texture_size
                    halign: "center"
                    valign: "center"
                    background_color: app.theme.transparent
        RepeatSpinner:
            spacing: 0
            text: app.repeat
            values: self.repeat_variants
            font_name: app.font
            on_text: app.repeat = self.text
            background_color: app.theme.transparent
            color: app.theme.button_text

<PlayerScreen>:
    Widget:
        canvas.before:
            Color:
                rgba: app.theme.background
            Rectangle:
                size: root.size
    BoxLayout:
        padding: Padding.box
        orientation: 'vertical'
        size: root.size
        spacing: Spacing.box

        TopPanel:

# TODO: https://kivy.org/doc/stable/api-kivy.graphics.boxshadow.html
        Image:
            source: root.now_playing.image if root.now_playing is not None else None
            fit_mode: "contain"
            # size_hint: Size.image
        BoxLayout:
            pos_hint: {"center_y": .5}
            size_hint: Size.title
            orientation: 'vertical'
            # spacing: Spacing.title
            TitleLabel:
                color: app.theme.text
                shorten: True
                shorten_from: 'right'
                text: root.now_playing.title if root.now_playing is not None else ""
                font_size: Size.title_font
                size: self.texture_size
                halign: "left"
                valign: "center"
                text_size: self.size
                max_lines: 1
                font_name: app.font
                pos_hint: {"center_y": .5}
            ArtistLabel:
                color: app.theme.text
                shorten: True
                shorten_from: 'right'
                text: root.now_playing.artist if root.now_playing is not None else ""
                font_size: Size.artist_font
                size: self.texture_size
                halign: "left"
                valign: "center"
                text_size: self.size
                max_lines: 1
                font_name: app.font
                pos_hint: {"center_y": .5}
        MusicSlider:
            orientation: 'horizontal'
            size_hint: Size.slider
            range: (0, root.length)
            value: root.slider_value
            on_touch_move: self.slider_move(args[1], self)
            on_touch_up: self.slider_up(args[1], self)
            value_track: True if root.slider_value != 0 else False
            value_track_color: app.theme.secondary
            value_track_width: 3
            background_width: self.value_track_width * 8
            step: 2
            cursor_size: 0, 0
            pos_hint: {"center_y": .5}
        BoxLayout: 
            size_hint: Size.time
            orientation: 'horizontal'
            spacing: 15
            PosLabel:
                color: app.theme.text
                halign: 'left'
                text: formated_time(round(root.track_pos))
                font_name: app.font
                text_size: self.size
            LengthLabel:
                color: app.theme.text
                id: length_label
                halign: 'right'
                text: formated_time(root.length)
                font_name: app.font
                text_size: self.size

        BoxLayout:
            size_hint: Size.play_buttons
            pos_hint: {"center_x": .5}
            orientation: 'horizontal'
            spacing: Spacing.player_buttons
            padding: Padding.buttons
            Widget:
            SeekBackwardButton:
                pos_hint: {"center_x": 0}
                size_hint: (None, None)
                border: 0, 0, 0, 0
                size: (40, 40)
                background_down: f'{application_path}/resources/images/replay_10.png'
                background_normal: f'{application_path}/resources/images/replay_10.png'
                background_color: app.theme.icon
            PreviousButton:
                id: previous_button
                pos_hint: {"center_x": .25}
                size_hint: (None, None)
                border: 0, 0, 0, 0
                size: (40, 40)
                background_down: f'{application_path}/resources/images/skip_previous.png'
                background_normal: f'{application_path}/resources/images/skip_previous.png'
                on_release: self.play_previous()
                background_color: app.theme.icon
            PlayButton:
                id: play_button
                pos_hint: {"center_x": .5}
                size_hint: (None, None)
                border: 0, 0, 0, 0
                size: (40, 40)
                background_down: f'{application_path}/resources/images/play_circle.png'
                background_normal: f'{application_path}/resources/images/play_circle.png'
                on_release: self.toggle_play()
                background_color: app.theme.icon
            NextButton:
                id: next_button
                pos_hint: {"center_x": .75}
                size_hint: (None, None)
                border: 0, 0, 0, 0
                size: (40, 40)
                background_down: f'{application_path}/resources/images/skip_next.png'
                background_normal: f'{application_path}/resources/images/skip_next.png'
                on_release: self.play_next()
                background_color: app.theme.icon
            SeekForwardButton:
                pos_hint: {"center_x": 1}
                border: 0, 0, 0, 0
                size_hint: (None, None)
                size: (40, 40)
                background_down: f'{application_path}/resources/images/forward_10.png'
                background_normal: f'{application_path}/resources/images/forward_10.png'
                background_color: app.theme.icon
            Widget:

        AnchorLayout:
            # FIXME: if possible create button with image that can be smaller than button
            size_hint: Size.queue
            QueueButton:
                background_color: app.theme.transparent
                background_normal: ""
                on_release: self.open_queue()
            Image:
                source:  f'{application_path}/resources/images/arrow_up.png'
                background_color: app.theme.transparent
                background_normal: ""
                size_hint: None, None
                pos_hint: {"center_x": .5}
                size: 100, 50
                color: app.theme.icon

# https://github.com/kivy-school/recycleex/blob/main
<TrackView>:
    index:
    now_playing: False
    on_release: self.play_track()
    background_color: app.theme.transparent
    background_normal: ""
    canvas.before:
        Color:
            rgba: app.theme.secondary if self.now_playing else app.theme.transparent
        Rectangle:
            size: self.size
            pos: self.pos
    Image:
        id: cover
        size_hint: None, 1
        fit_mode: "contain"
    BoxLayout:
        orientation: "vertical"
        Label:
            color: app.theme.text
            id: title
            font_size: Size.queue_title_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "bottom"
        Label:
            color: app.theme.text
            id: artist
            font_size: Size.queue_artist_font
            shorten: True
            shorten_from: "right"
            font_name: app.font
            text_size: self.size
            size: self.texture_size
            halign: "left"
            valign: "top"
    Label:
        color: app.theme.text
        id: duration
        font_name: app.font
        size_hint: None, 1
        size: self.texture_size
        valign: "center"
        halign: "center"
    AnchorLayout:
        size_hint: None, 1
        size: 25, 25
        ImageButton:
            id: uv_options
            on_release: Factory.TrackOptions(root.index).open()
            source: f'{application_path}/resources/images/more_vert.png'
            fit_mode: "contain"
            background_normal: ""
            background_color: app.theme.transparent
            color: app.theme.transparent

<OptionsPlayButton>:
    text: "Play"
    font_name: app.font
    color: app.theme.button_text

<AddToQueueButton>:
    text: "Add to queue"
    font_name: app.font
    color: app.theme.button_text

<InsertNextButton>:
    text: "Insert next"
    font_name: app.font
    color: app.theme.button_text

<TrackOptions>:
    size_hint: None, None
    size: 300, 150
    background_color: app.theme.background_secondary
    GridLayout:
        rows: 3
        OptionsPlayButton:
            on_release: root.play()
            background_color: app.theme.transparent
        AddToQueueButton:
            on_release: root.add_to_queue()
            background_color: app.theme.transparent
        InsertNextButton:
            on_release: root.insert_next()
            background_color: app.theme.transparent

<QueueView>:
    viewclass: "TrackView"
    bar_width: dp(0)
    scroll_wheel_distance: dp(56)
    effect_cls: ScrollEffect
    JumpRecycleBoxLayout:
        default_size: None, dp(56)
        default_size_hint: 1, None
        height: self.minimum_height
        orientation: "vertical"
        size_hint_y: None
        spacing: 10

<QueueScreen>:
    id: queue_screen
    on_pre_enter: self.update_queue_screen()
    Widget:
        canvas.before:
            Color:
                rgba: app.theme.background
            Rectangle:
                size: root.size
    BoxLayout:
        padding: Padding.box
        orientation: 'vertical'
        size: root.size
        spacing: Spacing.box

        TopPanel:

        QueueView:
            id: qv

        AnchorLayout:
            size_hint: Size.queue
            CloseQueueButton:
                background_normal: ""
                on_release: self.close_queue()
                background_color: app.theme.transparent
            Image:
                source:  f'{application_path}/resources/images/arrow_down_80dp.png'
                size_hint: None, None
                pos_hint: {"center_x": .5}
                size: 100, 50
                background_normal: ""
                background_color: app.theme.transparent
                color: app.theme.transparent

<ExitDialog>:
    size_hint: None, None
    size: 300, 150
    background_color: app.theme.background_secondary
    GridLayout:
        rows: 2
        Label:
            color: app.theme.text
            text: "Are you sure you want to exit?"
            font_name: app.font
        GridLayout:
            cols: 2
            spacing: 5
            Button:
                text: "Yes"
                on_release: app.stop()
                background_color: app.theme.transparent
                color: app.theme.button_text
                background_normal: ""
                canvas.before:
            Button:
                text: "No"
                on_release: root.dismiss()
                background_color: app.theme.transparent
                color: app.theme.button_text
                background_normal: ""
                # canvas.before:
                #     Color:
                #         rgba: app.theme.border
                #     Line:
                #         width: 1
                #         rectangle: self.x, self.y, self.width, self.height
